<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>SerialPortLib</PackageId>
    <Version>1.4.0</Version>
    <Authors>Generoso Martello</Authors>
    <Company>G-Labs</Company>
    <Description>Serial Port library for .Net
      Features
      - Easy to use
      - Event driven
      - Hot plug
      - Automatically re-establish connection on error/disconnect</Description>
    <PackageLicense>./LICENSE</PackageLicense>
    <PackageProjectUrl>https://github.com/genielabs/serialport-lib-dotnet/</PackageProjectUrl>
    <PackageTags>serial port</PackageTags>
    <TargetFrameworks>netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <!-- .NET 10 -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
  </ItemGroup>

  <!-- .NET 8 (LTS) -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- Base Target -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' or '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="System.IO.Ports" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GLabs.Logging" Version="1.1.0" />
  </ItemGroup>
</Project>
